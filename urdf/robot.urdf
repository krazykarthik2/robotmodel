<?xml version="1.0"?>
<robot name="robot_4dof">
  <!-- 4 revolute arm joints + 1-DOF parallel gripper (two prismatic fingers, one command). -->

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.025"/>
      <geometry><cylinder length="0.05" radius="0.08"/></geometry>
      <material name="orange"><color rgba="1.0 0.45 0.1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.025"/>
      <geometry><cylinder length="0.05" radius="0.08"/></geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <origin xyz="0 0 0.025"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.05"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="20" velocity="2"/>
  </joint>

  <link name="link1">
    <visual>
      <origin xyz="0 0 0.1"/>
      <geometry><cylinder length="0.2" radius="0.03"/></geometry>
      <material name="orange"><color rgba="1.0 0.45 0.1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.1"/>
      <geometry><cylinder length="0.2" radius="0.03"/></geometry>
    </collision>
    <inertial>
      <mass value="0.6"/>
      <origin xyz="0 0 0.1"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.0004"/>
    </inertial>
  </link>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.2"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="20" velocity="2"/>
  </joint>

  <link name="link2">
    <visual>
      <origin xyz="0 0 0.1"/>
      <geometry><box size="0.05 0.05 0.2"/></geometry>
      <material name="orange"><color rgba="1.0 0.45 0.1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.1"/>
      <geometry><box size="0.05 0.05 0.2"/></geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0.1"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.0004"/>
    </inertial>
  </link>

  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 0.2"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="20" velocity="2"/>
  </joint>

  <link name="link3">
    <visual>
      <origin xyz="0 0 0.1"/>
      <geometry><box size="0.045 0.045 0.2"/></geometry>
      <material name="orange"><color rgba="1.0 0.45 0.1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.1"/>
      <geometry><box size="0.045 0.045 0.2"/></geometry>
    </collision>
    <inertial>
      <mass value="0.4"/>
      <origin xyz="0 0 0.1"/>
      <inertia ixx="0.0015" ixy="0" ixz="0" iyy="0.0015" iyz="0" izz="0.0003"/>
    </inertial>
  </link>

  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="ee_link"/>
    <origin xyz="0 0 0.2"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="10" velocity="3"/>
  </joint>

  <link name="ee_link">
    <visual>
      <geometry><sphere radius="0.02"/></geometry>
      <material name="gray"><color rgba="0.4 0.4 0.45 1"/></material>
    </visual>
    <collision>
      <geometry><sphere radius="0.018"/></geometry>
    </collision>
    <inertial>
      <mass value="0.08"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
  </link>

  <joint name="gripper_base_joint" type="fixed">
    <parent link="ee_link"/>
    <child link="gripper_base"/>
    <origin xyz="0 0 0.03"/>
  </joint>

  <link name="gripper_base">
    <visual>
      <origin xyz="0 0 0.01"/>
      <geometry><box size="0.06 0.08 0.02"/></geometry>
      <material name="gray"><color rgba="0.45 0.45 0.5 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.01"/>
      <geometry><box size="0.06 0.08 0.02"/></geometry>
    </collision>
    <inertial>
      <mass value="0.12"/>
      <origin xyz="0 0 0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- Prismatic: 0 = open, 0.022 = closed. Env mirrors the command to both fingers. -->
  <joint name="gripper_left_joint" type="prismatic">
    <parent link="gripper_base"/>
    <child link="gripper_left"/>
    <origin xyz="0.02 -0.038 0.03"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="0.022" effort="30" velocity="0.2"/>
  </joint>

  <link name="gripper_left">
    <visual>
      <origin xyz="0 0 0.02"/>
      <geometry><box size="0.012 0.012 0.06"/></geometry>
      <material name="black"><color rgba="0.1 0.1 0.12 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.02"/>
      <geometry><box size="0.012 0.012 0.06"/></geometry>
    </collision>
    <inertial>
      <mass value="0.04"/>
      <origin xyz="0 0 0.02"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="gripper_right_joint" type="prismatic">
    <parent link="gripper_base"/>
    <child link="gripper_right"/>
    <origin xyz="0.02 0.038 0.03"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="0.022" effort="30" velocity="0.2"/>
  </joint>

  <link name="gripper_right">
    <visual>
      <origin xyz="0 0 0.02"/>
      <geometry><box size="0.012 0.012 0.06"/></geometry>
      <material name="black"><color rgba="0.1 0.1 0.12 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.02"/>
      <geometry><box size="0.012 0.012 0.06"/></geometry>
    </collision>
    <inertial>
      <mass value="0.04"/>
      <origin xyz="0 0 0.02"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
</robot>
